rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check valid string
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /inventory_movements/{movementId} {
      allow read, write: if true;
    }

    match /purchase_orders/{orderId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /remisiones/{remisionId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
